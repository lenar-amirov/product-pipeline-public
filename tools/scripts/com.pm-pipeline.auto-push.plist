<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pm-pipeline.auto-push</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "$HOME/Claude/Product management" &amp;&amp; LOCAL=$(git rev-parse HEAD 2>/dev/null) &amp;&amp; REMOTE=$(git rev-parse origin/main 2>/dev/null) &amp;&amp; [ "$LOCAL" != "$REMOTE" ] &amp;&amp; git pull --rebase origin main &amp;&amp; git push origin main</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/tmp/pm-pipeline-auto-push.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pm-pipeline-auto-push.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
